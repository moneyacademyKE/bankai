-record(db_state, {
    adapter :: aarondb@storage:storage_adapter(),
    eavt :: gleam@dict:dict(aarondb@fact:entity_id(), list(aarondb@fact:datom())),
    aevt :: gleam@dict:dict(binary(), list(aarondb@fact:datom())),
    avet :: gleam@dict:dict(binary(), gleam@dict:dict(aarondb@fact:value(), aarondb@fact:entity_id())),
    latest_tx :: integer(),
    subscribers :: list(gleam@erlang@process:subject(list(aarondb@fact:datom()))),
    schema :: gleam@dict:dict(binary(), aarondb@fact:attribute_config()),
    functions :: gleam@dict:dict(binary(), fun((aarondb@shared@state:db_state(), integer(), integer(), list(aarondb@fact:value())) -> list({aarondb@fact:eid(),
        binary(),
        aarondb@fact:value()}))),
    composites :: list(list(binary())),
    reactive_actor :: gleam@erlang@process:subject(aarondb@shared@state:reactive_message()),
    followers :: list(gleam@erlang@process:pid_()),
    is_distributed :: boolean(),
    ets_name :: gleam@option:option(binary()),
    vec_index :: aarondb@vec_index:vec_index(),
    bm25_indices :: gleam@dict:dict(binary(), aarondb@index@bm25:b_m25_index()),
    art_index :: aarondb@index@art:art(),
    registry :: gleam@dict:dict(binary(), aarondb@shared@state:index_adapter()),
    extensions :: gleam@dict:dict(binary(), aarondb@shared@state:extension_instance()),
    predicates :: gleam@dict:dict(binary(), fun((aarondb@fact:value()) -> boolean())),
    stored_rules :: list(aarondb@shared@ast:rule()),
    virtual_predicates :: gleam@dict:dict(binary(), aarondb@shared@state:virtual_adapter()),
    columnar_store :: gleam@dict:dict(binary(), list(aarondb@storage@internal:storage_chunk())),
    config :: aarondb@shared@state:config(),
    query_history :: list(aarondb@shared@state:query_context())
}).
